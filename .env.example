# Copy to ~/.config/signal-agent/env (outside the repo) or .env. Never commit real values.
SIGNAL_DATABASE_URL=postgresql://signal:signal-local-only@127.0.0.1:55433/signal
ANTHROPIC_API_KEY=
# Free alternative: with only this set, Signal uses OpenRouter's free models (50 requests/day without credits)
OPENROUTER_API_KEY=
# anthropic | openrouter | auto (Anthropic when its key is set)
SIGNAL_LLM_PROVIDER=auto
# Optional hard cap on model requests per process
# SIGNAL_MAX_REQUESTS=40
# Leave empty for the provider defaults in src/signal_agent/llm/factory.py
SIGNAL_MODEL_SMALL=
SIGNAL_MODEL_LARGE=
SIGNAL_MODEL_JUDGE=
SIGNAL_PROFILE=ayush
# Optional: send traces to Langfuse as well as Postgres (needs `uv sync --extra langfuse`)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
# Optional: require HTTP basic auth (user "signal") on the review UI, e.g. once deployed
SIGNAL_UI_PASSWORD=
